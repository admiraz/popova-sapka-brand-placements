# Copy to .env.local (or export directly in your build shell) and fill in
# the real deployment values before running `pnpm build`. Neither variable
# is a secret — both are NEXT_PUBLIC_ build-time config inlined into the
# static export, not credentials — so this file is safe to commit as-is.

# Origin only, no path — lib/metadata.ts and lib/utils.ts's assetUrl() add
# the base path themselves. Used for metadataBase, canonical URLs, hreflang
# alternates, JSON-LD, and Open Graph/Twitter image URLs.
# Falls back to a placeholder domain when unset.
NEXT_PUBLIC_SITE_URL=https://popovashapka.com.mk

# Leading slash, no trailing slash. Required only for a subfolder deploy
# (e.g. serving this export from popovashapka.com.mk/partnership/); leave
# unset for a root-domain deploy. See README.md "Deployment" for details.
NEXT_PUBLIC_BASE_PATH=/partnership
